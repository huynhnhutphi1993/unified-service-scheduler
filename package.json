{
  "name": "unified-service-scheduler",
  "version": "0.0.1",
  "description": "Customer service scheduling with PostgreSQL concurrency guarantees",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --require dotenv/config dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "db:migrate": "npm run build && node --require dotenv/config ./node_modules/@mikro-orm/cli/cli.js migration:up --config ./dist/database/mikro-orm.config.js",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "db:roles": "npm run build && node --require dotenv/config dist/database/bootstrap-roles.js",
    "db:seed": "npm run build && node --require dotenv/config dist/database/seed-foundation.js && node --require dotenv/config dist/auth/scripts/seed-accounts.js",
    "env:init": "node scripts/init-env.mjs",
    "demo": "node scripts/demo.mjs",
    "logs:summary": "node scripts/summarize-logs.mjs"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.1",
    "@mikro-orm/decorators": "7.2.1",
    "@mikro-orm/migrations": "7.2.1",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.2",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "1.16.2",
    "@types/express": "^5.0.0",
    "@types/luxon": "3.7.5",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
