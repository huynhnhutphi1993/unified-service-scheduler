# Copy to .env. Generate independent random passwords; URL-encode URL passwords.
POSTGRES_PASSWORD=replace-with-random-admin-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scheduler_app:replace-with-random-app-password@127.0.0.1:5432/scheduler
MIGRATION_DATABASE_URL=postgresql://scheduler_admin:replace-with-random-admin-password@127.0.0.1:5432/scheduler
# Dedicated disposable database. Never point this at the application database.
TEST_DATABASE_URL=postgresql://scheduler_admin:replace-with-random-admin-password@127.0.0.1:5432/scheduler_test
JWT_SECRET_BASE64=replace-with-at-least-32-random-bytes-in-base64
SEED_CUSTOMER_A_PASSWORD=replace-with-at-least-15-characters
SEED_CUSTOMER_B_PASSWORD=replace-with-at-least-15-characters
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
